{
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "PowerShell(uv *)",
      "Bash(.venv/Scripts/python.exe *)",
      "PowerShell(.venv/Scripts/python.exe *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(docker compose stop*)",
      "Bash(docker compose config*)",
      "PowerShell(docker compose ps*)",
      "PowerShell(docker compose logs *)",
      "PowerShell(docker compose up *)",
      "PowerShell(docker compose stop*)",
      "PowerShell(docker compose config*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "Edit(apps/**)",
      "Edit(tests/**)",
      "Edit(journey/**)",
      "Edit(docs/**)",
      "Edit(scripts/**)"
    ],
    "ask": [
      "Bash(docker compose down*)",
      "PowerShell(docker compose down*)",
      "Bash(git commit*)",
      "PowerShell(git commit*)",
      "Bash(git push*)",
      "PowerShell(git push*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
