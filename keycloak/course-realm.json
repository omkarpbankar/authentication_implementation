        "http://localhost:8005/*"
      ],
      "webOrigins": [
        "http://localhost:8005"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8005/*"
      },
      "protocolMappers": []
    },
    {
      "clientId": "app6-oidc",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "app6-oidc-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8006/*"
      ],
      "webOrigins": [
        "http://localhost:8006"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8006/*",
        "backchannel.logout.url": "http://host.docker.internal:8006/backchannel-logout",
        "backchannel.logout.session.required": "true"
      },
      "protocolMappers": [],
      "frontchannelLogout": false
    },
    {
      "clientId": "http://localhost:8007/saml/metadata",
      "name": "app6-saml",
      "enabled": true,
      "protocol": "saml",
      "defaultClientScopes": [
        "saml_organization"
      ],
      "redirectUris": [
        "http://localhost:8007/*"
      ],
      "frontchannelLogout": true,
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.client.signature": "false",
        "saml.authnstatement": "true",
        "saml_name_id_format": "persistent",
        "saml_force_name_id_format": "true",
        "saml_assertion_consumer_url_post": "http://localhost:8007/saml/acs",
        "saml_single_logout_service_url_redirect": "http://localhost:8007/saml/sls"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "roles",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "config": {
            "single": "true",
            "attribute.name": "roles",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    },
    {
      "clientId": "app7-tester",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
