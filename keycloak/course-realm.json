{
  "realm": "course",
  "enabled": true,
  "displayName": "Authentication Course",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 1,
  "roles": {
    "realm": [
      {
        "name": "reader"
      },
      {
        "name": "writer"
      },
      {
        "name": "default-roles-course",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "app2-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "app2-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8002/*",
        "http://localhost:8012/*"
      ],
      "webOrigins": [
        "http://localhost:8002",
        "http://localhost:8012"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8002/*##http://localhost:8012/*"
      },
      "protocolMappers": [
        {
          "name": "audience-app2-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "app2-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "app2-worker",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "app2-worker-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-app2-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "app2-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "app2-cli",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-app2-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "app2-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "app5-social",
      "enabled": true,
